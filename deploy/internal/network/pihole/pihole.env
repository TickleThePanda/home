FTLCONF_dns_bogusPriv=false
FTLCONF_dns_interface=eth0
FTLCONF_dns_listeningMode=SINGLE
FTLCONF_dns_reply_host_force4=true
FTLCONF_dns_reply_host_IPv4=192.168.1.10
FTLCONF_files_macvendor=/macvendor.db
FTLCONF_misc_readOnly=true
# home.arpa is served by BIND (via Unbound), not locally. FTL v6.5+ only
# drops its built-in local=/home.arpa/ when its own domain is home.arpa and
# marked non-local -- then it forwards upstream (pi-hole/FTL#2772).
FTLCONF_dns_domain_name=home.arpa
FTLCONF_dns_domain_local=false
