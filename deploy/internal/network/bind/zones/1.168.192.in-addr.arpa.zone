$ORIGIN 1.168.192.in-addr.arpa.
$TTL 300

@   IN SOA ns.home.arpa. admin.ticklethepanda.co.uk. (
        2026090711 ; serial (named bumps this on every update)
        3600       ; refresh
        600        ; retry
        86400      ; expire
        300 )      ; minimum

@   IN NS  ns.home.arpa.

; Nothing seeded beyond NS/SOA -- PTRs are written by dynamic update (Kea for
; leases, external-dns-static for the gateway and k3s VMs).
