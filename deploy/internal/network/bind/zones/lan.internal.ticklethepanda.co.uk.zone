$ORIGIN lan.internal.ticklethepanda.co.uk.
$TTL 300

@   IN SOA ns.lan.internal.ticklethepanda.co.uk. admin.ticklethepanda.co.uk. (
        2026090100 ; serial (named bumps this on every update)
        3600       ; refresh
        600        ; retry
        86400      ; expire
        300 )      ; minimum

@   IN NS ns.lan.internal.ticklethepanda.co.uk.
ns  IN A  10.43.53.55

; The gateway is not a DHCP client, so Kea can't register it -- seeded here.
; Everything else in this zone is written by Kea DHCP-DDNS / ExternalDNS.
gateway IN A  192.168.1.1
