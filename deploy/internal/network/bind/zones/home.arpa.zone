$ORIGIN home.arpa.
$TTL 300

@   IN SOA ns.home.arpa. admin.ticklethepanda.co.uk. (
        2026090711 ; serial (named bumps this on every update)
        3600       ; refresh
        600        ; retry
        86400      ; expire
        300 )      ; minimum

@   IN NS ns.home.arpa.
ns  IN A  10.43.53.55

; Every record in this zone is written by dynamic update: Kea DHCP-DDNS for
; leases, the discovery external-dns for Services/Ingresses, external-dns-static
; (deploy/internal/network/dns-static/) for non-DHCP hosts like the gateway and
; the k3s VMs. Nothing is seeded here beyond NS/SOA.
