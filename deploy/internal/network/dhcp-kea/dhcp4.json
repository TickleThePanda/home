{
  "Dhcp4": {
    "interfaces-config": {
      "interfaces": [
        "net1"
      ],
      "dhcp-socket-type": "raw"
    },

    "authoritative": true,

    "valid-lifetime": 86400,
    "renew-timer": 43200,
    "rebind-timer": 75600,

    // Kea 3.x defaults cache-threshold to 0.25: a renewal within the first
    // quarter of the lease reuses the cached lease and skips DDNS entirely,
    // which would defeat ddns-update-on-renew. 0 disables lease caching.
    "cache-threshold": 0.0,

    "lease-database": {
      "type": "memfile",
      "persist": true,
      "name": "/kea/leases/kea-leases4.csv",
      "lfc-interval": 3600
    },

    // Unix control channel for kea-dhcp4 (lease queries, lease4-resend-ddns,
    // stats). The image only permits sockets under /kea/sockets.
    "control-socket": {
      "socket-type": "unix",
      "socket-name": "/kea/sockets/kea4-ctrl-socket"
    },

    // lease_cmds adds lease4-get-* and lease4-resend-ddns over the socket.
    "hooks-libraries": [
      { "library": "/usr/local/lib/kea/hooks/libdhcp_lease_cmds.so" }
    ],

    // Hand every lease's name to the DHCP-DDNS sidecar (127.0.0.1:53001),
    // which updates BIND. Qualified into the local zone; sanitise odd names.
    "dhcp-ddns": {
      "enable-updates": true,
      "server-ip": "127.0.0.1",
      "server-port": 53001
    },
    "ddns-send-updates": true,
    "ddns-update-on-renew": true,
    "ddns-qualifying-suffix": "home.arpa.",
    "ddns-override-client-update": true,
    "ddns-override-no-update": true,
    "ddns-replace-client-name": "when-not-present",
    "hostname-char-set": "[^A-Za-z0-9.-]",
    "hostname-char-replacement": "-",

    "subnet4": [
      {
        "id": 1,
        "subnet": "192.168.1.0/24",

        "pools": [
          {
            "pool": "192.168.1.21 - 192.168.1.200"
          }
        ],

        "option-data": [
          {
            "name": "routers",
            "data": "192.168.1.1"
          },
          {
            "name": "subnet-mask",
            "data": "255.255.255.0"
          },
          {
            "name": "domain-name-servers",
            "data": "192.168.1.10"
          },
          {
            "name": "domain-search",
            "data": "home.arpa"
          }
        ],

        "reservations": [
          {
            "hw-address": "48:f6:ee:2b:08:e8",
            "ip-address": "192.168.1.24"
          },
          {
            "hw-address": "dc:a6:32:26:bf:26",
            "ip-address": "192.168.1.5"
          }
        ]
      },
      {
        // Trusted VLAN. Reached only via the DHCP relay on the router
        // (192.168.10.1 -> 192.168.1.11); Kea matches it by giaddr. Replies
        // go back to the relay as an L2 frame on net1, so no extra interface
        // or route is needed here.
        "id": 2,
        "subnet": "192.168.10.0/24",

        "relay": { "ip-addresses": [ "192.168.10.1" ] },

        "pools": [
          {
            "pool": "192.168.10.21 - 192.168.10.200"
          }
        ],

        "option-data": [
          {
            "name": "routers",
            "data": "192.168.10.1"
          },
          {
            "name": "subnet-mask",
            "data": "255.255.255.0"
          },
          {
            "name": "domain-name-servers",
            "data": "192.168.1.10"
          },
          {
            "name": "domain-search",
            "data": "home.arpa"
          }
        ]
      },

      // IoT VLANs. Wi-Fi only, reached via per-VLAN DHCP relays on the router
      // (192.168.<n>.1 -> 192.168.1.11); Kea matches each by giaddr. Every
      // IoT subnet points DNS at Pi-hole (192.168.1.10) and NTP at its own
      // gateway (the router runs an NTP server for these VLANs). iot_local
      // (id 4) has no route to the internet -- firewall, not DHCP.
      {
        "id": 3,
        "subnet": "192.168.20.0/24",
        "relay": { "ip-addresses": [ "192.168.20.1" ] },
        "pools": [ { "pool": "192.168.20.21 - 192.168.20.200" } ],
        "option-data": [
          { "name": "routers", "data": "192.168.20.1" },
          { "name": "subnet-mask", "data": "255.255.255.0" },
          { "name": "domain-name-servers", "data": "192.168.1.10" },
          { "name": "ntp-servers", "data": "192.168.20.1" },
          { "name": "domain-search", "data": "home.arpa" }
        ]
      },
      {
        "id": 4,
        "subnet": "192.168.30.0/24",
        "relay": { "ip-addresses": [ "192.168.30.1" ] },
        "pools": [ { "pool": "192.168.30.21 - 192.168.30.200" } ],
        "option-data": [
          { "name": "routers", "data": "192.168.30.1" },
          { "name": "subnet-mask", "data": "255.255.255.0" },
          { "name": "domain-name-servers", "data": "192.168.1.10" },
          { "name": "ntp-servers", "data": "192.168.30.1" },
          { "name": "domain-search", "data": "home.arpa" }
        ]
      },
      {
        "id": 5,
        "subnet": "192.168.40.0/24",
        "relay": { "ip-addresses": [ "192.168.40.1" ] },
        "pools": [ { "pool": "192.168.40.21 - 192.168.40.200" } ],
        "option-data": [
          { "name": "routers", "data": "192.168.40.1" },
          { "name": "subnet-mask", "data": "255.255.255.0" },
          { "name": "domain-name-servers", "data": "192.168.1.10" },
          { "name": "ntp-servers", "data": "192.168.40.1" },
          { "name": "domain-search", "data": "home.arpa" }
        ]
      }
    ],

    "loggers": [
      {
        "name": "kea-dhcp4",
        "output_options": [
          {
            "output": "stdout"
          }
        ],
        "severity": "INFO"
      }
    ]
  }
}
