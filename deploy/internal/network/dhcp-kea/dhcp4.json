{
  "Dhcp4": {
    "interfaces-config": {
      "interfaces": [
        "net1"
      ],
      "dhcp-socket-type": "raw"
    },

    "authoritative": true,

    "valid-lifetime": 86400,
    "renew-timer": 43200,
    "rebind-timer": 75600,

    "lease-database": {
      "type": "memfile",
      "persist": true,
      "name": "/kea/leases/kea-leases4.csv",
      "lfc-interval": 3600
    },

    // Hand every lease's name to the DHCP-DDNS sidecar (127.0.0.1:53001),
    // which updates BIND. Qualified into home.arpa; sanitise odd hostnames.
    "dhcp-ddns": {
      "enable-updates": true,
      "server-ip": "127.0.0.1",
      "server-port": 53001
    },
    "ddns-send-updates": true,
    "ddns-qualifying-suffix": "home.arpa.",
    "ddns-override-client-update": true,
    "ddns-override-no-update": true,
    "ddns-replace-client-name": "when-not-present",
    "hostname-char-set": "[^A-Za-z0-9.-]",
    "hostname-char-replacement": "-",

    "subnet4": [
      {
        "id": 1,
        "subnet": "192.168.1.0/24",

        "pools": [
          {
            "pool": "192.168.1.21 - 192.168.1.200"
          }
        ],

        "option-data": [
          {
            "name": "routers",
            "data": "192.168.1.1"
          },
          {
            "name": "subnet-mask",
            "data": "255.255.255.0"
          },
          {
            "name": "domain-name-servers",
            "data": "192.168.1.10"
          },
          {
            // RFC 8375: put home.arpa in the search list (option 119), never
            // as the domain-name -- it isn't globally unique.
            "name": "domain-search",
            "data": "home.arpa"
          }
        ],

        "reservations": [
          {
            "hw-address": "48:f6:ee:2b:08:e8",
            "ip-address": "192.168.1.24"
          },
          {
            "hw-address": "dc:a6:32:26:bf:26",
            "ip-address": "192.168.1.5"
          }
        ]
      }
    ],

    "loggers": [
      {
        "name": "kea-dhcp4",
        "output_options": [
          {
            "output": "stdout"
          }
        ],
        "severity": "INFO"
      }
    ]
  }
}
