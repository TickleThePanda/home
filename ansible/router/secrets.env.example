# Copy to ansible/router/secrets.env (gitignored) for a local run of
# router.yml; CI has the same names as `prod` environment secrets.
# Single-quote each value so a literal '$' (as in the root hash) survives
# being sourced.

ROUTER_PPPOE_USERNAME='dsl000000000@broadband.vodafone.co.uk'
ROUTER_PPPOE_PASSWORD=''

# Shared PSK for both "It reaches out" SSIDs.
ROUTER_WIFI_KEY=''

# Per-profile PPSK for the two IoT SSIDs: the key a device joins with selects
# its VLAN. One per profile, not shared.
ROUTER_WIFI_IOT_KEY_INET=''
ROUTER_WIFI_IOT_KEY_LOCAL=''
ROUTER_WIFI_IOT_KEY_ECHO=''

# Optional. root / LuCI password as its crypt hash, the second field of the
# router's `root:` line in /etc/shadow (make one with `openssl passwd -5`).
# Unset leaves the password alone.
ROUTER_ROOT_PASSWORD_HASH=''

# Optional. Tailscale auth key: tagged tag:home-router, reusable,
# non-ephemeral. Only used when the router is logged out of the tailnet.
ROUTER_TS_AUTHKEY=''
