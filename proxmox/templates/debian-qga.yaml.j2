#cloud-config
# Managed by proxmox/tasks/vm-template.yml. Referenced as the cloud-init
# vendor-data for every k3s VM (qm --cicustom). User, SSH key, hostname and
# network come from per-VM cloud-init set by community.proxmox, not here.
#
# Debian's genericcloud image is minimal:
#   - qemu-guest-agent    Proxmox needs it for IP reporting / clean shutdown
#   - curl                the k3s install script (run by k3s-cluster/) needs it
package_update: true
packages:
  - qemu-guest-agent
  - curl
runcmd:
  - [systemctl, enable, --now, qemu-guest-agent]
