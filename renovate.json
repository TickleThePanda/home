{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Updates container images, Helm charts, vendor.txt, GitHub Actions, Ansible collections and ansible-core, k3s, Flux, Terraform and its providers, and app Dockerfiles. Non-major updates merge into main once .github/workflows/validate.yaml passes; majors wait for approval on the Dependency Dashboard.",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled"
  ],
  "enabledManagers": [
    "kubernetes",
    "flux",
    "kustomize",
    "github-actions",
    "ansible-galaxy",
    "pip_requirements",
    "terraform",
    "dockerfile",
    "gomod",
    "docker-compose",
    "custom.regex"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^deploy/.+\\.ya?ml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/^deploy/.+\\.ya?ml$/"
    ]
  },
  "ansible-galaxy": {
    "managerFilePatterns": [
      "/^ansible/requirements\\.yml$/"
    ]
  },
  "pip_requirements": {
    "managerFilePatterns": [
      "/^\\.github/actions/ansible-setup/requirements\\.txt$/"
    ]
  },
  "dockerfile": {
    "managerFilePatterns": [
      "/^apps/.+/Dockerfile[^/]*$/"
    ]
  },
  "automerge": true,
  "automergeType": "branch",
  "customManagers": [
    {
      "customType": "regex",
      "description": "vendor.txt: the version column, located by the `# renovate:` comment above each entry",
      "managerFilePatterns": [
        "/^vendor\\.txt$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\S+\\s+(?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "^v?(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "The Renovate CLI that scripts/check-renovate.sh runs in CI",
      "managerFilePatterns": [
        "/^\\.github/workflows/validate\\.yaml$/"
      ],
      "matchStrings": [
        "RENOVATE_VERSION: (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "k3s_version, the cluster's k3s release",
      "managerFilePatterns": [
        "/^ansible/k3s/vars/versions\\.yml$/"
      ],
      "matchStrings": [
        "k3s_version: \"(?<currentValue>v[^\"]+)\""
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "The Flux release: the FluxInstance's distribution.version and the flux CLI that CI installs",
      "managerFilePatterns": [
        "/^flux-system/instance/flux-instance\\.yaml$/",
        "/^\\.github/workflows/deploy-cluster\\.yaml$/"
      ],
      "matchStrings": [
        "distribution:\\n(?:\\s*#.*\\n)*\\s*version: \"(?<currentValue>[^\"]+)\"",
        "fluxcd/flux2/action@\\S+\\n\\s+with:\\n\\s+version: (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "fluxcd/flux2",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "kubeconform, installed by the validate-cluster action",
      "managerFilePatterns": [
        "/^\\.github/actions/validate-cluster/action\\.yml$/"
      ],
      "matchStrings": [
        "KUBECONFORM_VERSION: (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "yannh/kubeconform",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "pip packages pinned in app Dockerfiles",
      "managerFilePatterns": [
        "/^apps/.+/Dockerfile[^/]*$/"
      ],
      "matchStrings": [
        "pip install [^\\n]*?(?<depName>[A-Za-z0-9_.-]+)==(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "The kubernetes manager also reports each manifest's apiVersion. Leave API migrations to humans.",
      "matchDatasources": [
        "kubernetes-api"
      ],
      "enabled": false
    },
    {
      "description": "Majors are manual: approve them on the Dependency Dashboard, then review and merge the PR. For pihole and cloudflared, the year rollover counts as a major.",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "ISC's stable Kea releases have even minor versions; odd minors are development releases. The two daemons release together (scripts/check-versions.sh).",
      "matchPackageNames": [
        "jonasal/kea-dhcp4",
        "jonasal/kea-dhcp-ddns"
      ],
      "allowedVersions": "/^3\\.\\d*[02468]\\.\\d+$/",
      "groupName": "kea"
    },
    {
      "description": "GeoPulse's UI and backend release together (scripts/check-versions.sh).",
      "matchPackageNames": [
        "tess1o/geopulse-backend",
        "tess1o/geopulse-ui"
      ],
      "groupName": "geopulse"
    },
    {
      "description": "RKE2's Multus chart pads its last component (v4.3.014), which strict semver rejects.",
      "matchPackageNames": [
        "rke2-multus"
      ],
      "versioning": "loose"
    },
    {
      "description": "k3s and ansible-core upgrade one minor at a time (ansible/k3s/vars/versions.yml, .github/actions/ansible-setup/requirements.txt). Each minor gets its own branch.",
      "matchPackageNames": [
        "k3s-io/k3s",
        "ansible-core"
      ],
      "separateMultipleMinor": true
    },
    {
      "description": "...and each minor waits for approval on the Dependency Dashboard, so they can be taken in order.",
      "matchPackageNames": [
        "k3s-io/k3s",
        "ansible-core"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "The flux CLI in CI and the cluster's Flux move together (scripts/check-versions.sh).",
      "matchPackageNames": [
        "fluxcd/flux2",
        "fluxcd/flux2/action"
      ],
      "groupName": "flux"
    },
    {
      "description": "The Go toolchain image and go.mod's go directive move together.",
      "matchPackageNames": [
        "golang",
        "go"
      ],
      "groupName": "go"
    },
    {
      "description": "One branch for every non-major GitHub Actions bump.",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "A Python minor can outrun what runs on it (ansible-core lists the Pythons it supports). Each waits for approval.",
      "matchPackageNames": [
        "python",
        "actions/python-versions"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}
