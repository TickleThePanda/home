# Managed by router/ansible (tasks/mdns-reflector.yml).
#
# mDNS reflector across the homelab, trusted and IoT VLAN bridges, plus it
# publishes the router's own address as {{ router_hostname }}.local
# (per-interface: each VLAN's clients get that VLAN's gateway address).
# allow-interfaces keeps both reflection and publishing off pppoe-wan and
# tailscale0. Reflection is hub-and-all: mDNS records are also visible between
# IoT VLANs, but the firewall blocks all L3 traffic between them.

[server]
host-name={{ router_hostname }}
use-ipv4=yes
use-ipv6=no
allow-interfaces={{ mdns_reflector_interfaces | join(',') }}
disallow-other-stacks=yes

[wide-area]
enable-wide-area=no

[publish]
publish-addresses=yes
publish-hinfo=no
publish-workstation=no
publish-domain=no
disable-user-service-publishing=yes

[reflector]
enable-reflector=yes
reflect-ipv=no
