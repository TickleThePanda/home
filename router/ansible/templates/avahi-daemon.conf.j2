# Managed by router/ansible (tasks/mdns-reflector.yml).
#
# mDNS reflector between the homelab and trusted bridges, plus it publishes the
# router's own address as {{ router_hostname }}.local (per-interface: the
# homelab clients get 192.168.1.1, trusted clients get 192.168.10.1).
# allow-interfaces keeps both reflection and publishing off pppoe-wan and
# tailscale0.

[server]
host-name={{ router_hostname }}
use-ipv4=yes
use-ipv6=no
allow-interfaces={{ mdns_reflector_interfaces | join(',') }}
disallow-other-stacks=yes

[wide-area]
enable-wide-area=no

[publish]
publish-addresses=yes
publish-hinfo=no
publish-workstation=no
publish-domain=no
disable-user-service-publishing=yes

[reflector]
enable-reflector=yes
reflect-ipv=no
