# Copy to router/secrets.env (gitignored) and fill in. Any value is fine
# (embedded via Jinja `shquote`). Single-quote each value so a literal '$'
# (e.g. in the root hash) survives being sourced.
#
# The current values live in the GL.iNet backup:
#   tar xzf backup-GL-MT6000-2026-09-01.tar.gz -O etc/config/network   # PPPoE
#   tar xzf backup-GL-MT6000-2026-09-01.tar.gz -O etc/config/wireless  # wifi key
#   tar xzf backup-GL-MT6000-2026-09-01.tar.gz -O etc/shadow           # root hash

ROUTER_PPPOE_USERNAME='dsl000000000@broadband.vodafone.co.uk'
ROUTER_PPPOE_PASSWORD=''

# Shared PSK for both "It reaches out" SSIDs.
ROUTER_WIFI_KEY=''

# root / LuCI password. Set exactly one:
#   ROUTER_ROOT_PASSWORD_HASH -- the existing `root:` hash from the backup's
#     etc/shadow (keeps the current login even if the plaintext is unknown), or
#   ROUTER_ROOT_PASSWORD      -- a plaintext, hashed at build time.
ROUTER_ROOT_PASSWORD_HASH=''
ROUTER_ROOT_PASSWORD=''

# Tailscale auth key: tagged (tag:home-router), reusable, non-ephemeral.
# The tailnet ACL needs matching tagOwners + autoApprovers entries -- see
# README.md.
ROUTER_TS_AUTHKEY=''
