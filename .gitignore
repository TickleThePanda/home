# Bootstrap keypair for the node's `deploy` user. Generated into the repo
# root by ansible/node/bootstrap.yml's documented flow, then uploaded to the
# NODE_SSH_KEY GitHub secret and shredded. Ignored so a stray `git add -A`
# can never commit the private half.
deploy_key
deploy_key.pub
__pycache__

# Ansible's jsonfile fact cache (ansible/ansible.cfg). Regenerated each run;
# in CI it is an actions/cache entry, not committed.
.ansible_fact_cache/

# Router bootstrap (router/bootstrap/). The GL.iNet backup and secrets.env hold
# live credentials (PPPoE, Wi-Fi PSK, WireGuard/host keys, /etc/shadow); build/
# holds the rendered overlay with secrets substituted in.
backup-GL-MT6000-*.tar.gz
router/bootstrap/secrets.env
router/bootstrap/authorized_keys.extra
router/bootstrap/build/
router/bootstrap/out/

# k3s.orchestration fetches the cluster kubeconfig here during a run
# (kubeconfig var in ansible/group_vars/k3s_cluster.yml). Not needed after --
# the real kubeconfig setup is documented in CLAUDE.md.
ansible/k3s/.kubeconfig

# Local scratch for the DOCKER_PULL_* values before they go to GitHub Actions
# secrets (`gh secret set --env prod`). Never committed -- the repo is public.
/.env

# Terraform local state/plugin/plan artifacts. terraform/bootstrap/ starts on
# local state before migrating into GCS (see terraform/bootstrap/README.md);
# terraform/cloudflare-zero-trust/ uses a GCS backend but still caches
# providers and plan files locally. .terraform.lock.hcl is NOT ignored -- it
# pins provider versions and belongs in git.
**/.terraform/
terraform.tfstate
terraform.tfstate.backup
*.tfplan
terraform/cloudflare-zero-trust/generated/

# Local-only Cloudflare API token for cf-terraforming / manual terraform runs
# against terraform/cloudflare-zero-trust/. Lives in GitHub Actions secrets
# for CI; never committed.
terraform/cloudflare-zero-trust/.cf-terraform-token
