# Bootstrap keypair for the node's `deploy` user. Generated into the repo
# root by node/bootstrap.yml's documented flow, then uploaded to the
# NODE_SSH_KEY GitHub secret and shredded. Ignored so a stray `git add -A`
# can never commit the private half.
deploy_key
deploy_key.pub
__pycache__

# Router bootstrap (router/bootstrap/). The GL.iNet backup and secrets.env hold
# live credentials (PPPoE, Wi-Fi PSK, WireGuard/host keys, /etc/shadow); build/
# holds the rendered overlay with secrets substituted in.
backup-GL-MT6000-*.tar.gz
router/bootstrap/secrets.env
router/bootstrap/authorized_keys.extra
router/bootstrap/build/
router/bootstrap/out/

# k3s.orchestration fetches the cluster kubeconfig here during a run
# (kubeconfig var in k3s-cluster/group_vars). Not needed after -- the real
# kubeconfig setup is documented in CLAUDE.md.
k3s-cluster/.kubeconfig

# Local scratch for the DOCKER_PULL_* values before they go to GitHub Actions
# secrets (`gh secret set --env prod`). Never committed -- the repo is public.
/.env
