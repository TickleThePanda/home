FROM golang:1.23-alpine AS builder
WORKDIR /src
COPY go.mod main.go ./
RUN CGO_ENABLED=0 go build -o /sync-runner .

FROM python:3.12-slim
RUN pip install --no-cache-dir librofm==0.2.0
COPY --from=builder /sync-runner /usr/local/bin/sync-runner
ENV RUNNER_MODE=librofm
ENV RUNNER_PORT=8090
ENTRYPOINT ["/usr/local/bin/sync-runner"]
