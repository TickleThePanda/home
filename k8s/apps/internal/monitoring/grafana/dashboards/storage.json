{
  "title": "Storage",
  "uid": "storage-lvm",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "\"data\" VG free % (Pi)",
      "type": "gauge",
      "description": "The unallocated pool every PersistentVolume is carved from. See LvmVolumeGroupSpaceLow/Critical alerts.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "thresholds": {
            "steps": [
              { "value": null, "color": "green" },
              { "value": 20, "color": "orange" },
              { "value": 10, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(node_volume_group_free{name=\"data\"} / node_volume_group_size{name=\"data\"}) * 100",
          "legendFormat": "data VG free %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "\"data\" VG size vs free",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "node_volume_group_size{name=\"data\"}", "legendFormat": "VG size", "refId": "A" },
        { "expr": "node_volume_group_free{name=\"data\"}", "legendFormat": "VG free", "refId": "B" }
      ]
    },
    {
      "id": 3,
      "title": "Physical volume size vs free",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "node_physical_volume_size", "legendFormat": "{{name}} size", "refId": "A" },
        { "expr": "node_physical_volume_free", "legendFormat": "{{name}} free", "refId": "B" }
      ]
    },
    {
      "id": 4,
      "title": "Disk space % by host + mount",
      "type": "timeseries",
      "description": "Every real (non-tmpfs/overlay/squashfs) mounted filesystem on every host. See HostDiskSpaceLow/Critical alerts.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "100 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs|fuse.*\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs|fuse.*\"} * 100)",
          "legendFormat": "{{hostname}} {{mountpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "PersistentVolumeClaim usage %",
      "type": "bargauge",
      "description": "One bar per PVC (namespace/claim), not per node -- summed across the kubelet job's own node labels, which would otherwise make every row's legend unreadable.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "thresholds": {
            "steps": [
              { "value": null, "color": "green" },
              { "value": 80, "color": "orange" },
              { "value": 90, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient" },
      "targets": [
        {
          "expr": "100 * sum by (namespace, persistentvolumeclaim) (kubelet_volume_stats_used_bytes) / sum by (namespace, persistentvolumeclaim) (kubelet_volume_stats_capacity_bytes)",
          "legendFormat": "{{namespace}}/{{persistentvolumeclaim}}",
          "refId": "A",
          "instant": true
        }
      ]
    }
  ]
}
